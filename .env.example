# Copie para .env e ajuste. O docker compose lê este arquivo sozinho.
# O .env fica fora do Git (.gitignore): nunca publique senhas reais.

# ---- Banco ----
MYSQL_ROOT_PASSWORD=root123
DB_USER=gado_app
DB_PASSWORD=gado123

# ---- API ----
# Gere um segredo longo (mínimo 32 caracteres), por exemplo: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-em-producao-0123456789
JWT_EXPIRACAO_HORAS=12
SEED_DADOS_EXEMPLO=true

# ---- Portas no computador ----
WEB_PORTA=80
API_PORTA=8080
MYSQL_PORTA=3306

# ---- Imagens (usado com "docker compose pull") ----
# Imagens publicadas pela CD no GitHub Container Registry
REGISTRO=ghcr.io/gaspamatheus
TAG=latest
