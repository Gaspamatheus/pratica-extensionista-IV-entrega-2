# Copie para .env.local se precisar mudar algo.

# Para onde o Vite repassa /api em desenvolvimento (padrão: http://localhost:8080)
# VITE_API_PROXY=http://localhost:8080

# Endereço completo da API, só quando o front for publicado separado dela
# (ex.: https://api.minhafazenda.com.br/api). Sem isso o app usa /api pelo proxy.
# VITE_API_URL=
